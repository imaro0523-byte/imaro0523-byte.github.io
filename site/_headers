# Response headers for hosts that support them (Netlify, Cloudflare Pages).
# GitHub Pages ignores this file entirely.
#
# The two paths get different policies on purpose.

# The guide site. May carry advertising, so it cannot be default-deny — but it
# never sees a class list, which is what makes that acceptable.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()

# The app. No third-party anything, and no framing.
/app/*
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; media-src 'none'; font-src 'none'; img-src data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; manifest-src 'self'; connect-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
